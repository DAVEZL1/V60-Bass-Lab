<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_dark_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="✨ NEURAL ACOUSTIC ENGINEER"
        android:textColor="@color/ios_purple"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Describe in natural language the bass character, subwoofer punch, or vocal clarity you desire."
        android:textColor="@color/ios_text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/dialog_et_prompt"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/studio_inset_well"
        android:hint="e.g.: Deep 90s subwoofer bass with crystal-clear vocals"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/ios_text_primary"
        android:textColorHint="@color/ios_text_tertiary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Artificial Intelligence Engine:"
        android:textColor="@color/ios_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/dialog_spinner_provider"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/ios_input_bg" />

    <EditText
        android:id="@+id/dialog_et_api_key"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/studio_inset_well"
        android:hint="API Key (optional for local endpoints)..."
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/ios_text_primary"
        android:textColorHint="@color/ios_text_tertiary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialog_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/ios_pill_bg"
            android:text="Cancel"
            android:textColor="@color/ios_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/dialog_btn_generate"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="2"
            android:background="@drawable/btn_gradient_capture"
            android:text="✨ Calibrate with AI"
            android:textColor="@color/ios_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
