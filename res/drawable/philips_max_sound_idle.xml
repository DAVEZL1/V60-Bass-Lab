<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFF3B30">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#241217"
                android:endColor="#170C10"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#55FF334B" />
        </shape>
    </item>
</ripple>
